<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>5-Second Video Annotator</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f4f4f4;
        color: #222;
    }

    .container {
        max-width: 1000px;
        margin: auto;
        padding: 20px;
    }

    h1 {
        text-align: center;
        margin-bottom: 20px;
    }

    .card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    label {
        display: block;
        font-weight: bold;
        margin-bottom: 8px;
    }

    input,
    textarea,
    button {
        font-size: 16px;
    }

    input[type="text"],
    textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    textarea {
        min-height: 100px;
        resize: vertical;
    }

    button {
        border: none;
        padding: 12px 18px;
        border-radius: 8px;
        cursor: pointer;
        margin: 5px;
        font-weight: bold;
    }

    .start-btn {
        background: #222;
        color: white;
        width: 100%;
    }

    .nav-btn {
        background: #ddd;
    }

    .save-btn {
        background: #222;
        color: white;
    }

    .download-btn {
        background: #222;
        color: white;
        width: 100%;
        margin-top: 15px;
    }

    button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    video {
        width: 100%;
        max-height: 550px;
        background: black;
        border-radius: 10px;
    }

    .segment-info {
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        margin: 15px 0;
    }

    .time-info {
        text-align: center;
        color: #666;
        margin-bottom: 15px;
    }

    .progress-container {
        width: 100%;
        height: 10px;
        background: #ddd;
        border-radius: 10px;
        overflow: hidden;
        margin: 15px 0;
    }

    .progress {
        height: 100%;
        width: 0%;
        background: #222;
    }

    .status {
        text-align: center;
        padding: 10px;
        font-weight: bold;
    }

    .table-container {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th,
    td {
        padding: 10px;
        border: 1px solid #ddd;
        text-align: left;
    }

    th {
        background: #eee;
    }

    .hidden {
        display: none;
    }
</style>
</head>

<body>

<div class="container">

    <h1>🎥 5-Second Video Annotator</h1>

    <!-- VIDEO INPUT -->
    <div class="card" id="setupCard">

        <label>Video URL</label>

        <input
            type="text"
            id="videoUrl"
            placeholder="Paste direct MP4 video URL here"
        >

        <label>Segment Duration (seconds)</label>

        <input
            type="number"
            id="segmentDuration"
            value="5"
            min="1"
        >

        <button class="start-btn" onclick="startProject()">
            START ANNOTATION
        </button>

        <p>
            Example segments:
            0–5 sec, 5–10 sec, 10–15 sec...
        </p>

    </div>


    <!-- VIDEO -->
    <div class="card hidden" id="videoCard">

        <video
            id="video"
            controls
            preload="metadata"
        ></video>

        <div class="segment-info" id="segmentInfo">
            Segment 1
        </div>

        <div class="time-info" id="timeInfo">
            0 – 5 seconds
        </div>

        <div class="progress-container">
            <div class="progress" id="progress"></div>
        </div>

        <div class="status" id="status">
            Ready
        </div>

    </div>


    <!-- COMMENT -->
    <div class="card hidden" id="commentCard">

        <label>
            Comment for this segment
        </label>

        <textarea
            id="comment"
            placeholder="Write what is happening in this segment..."
        ></textarea>

        <div style="text-align:center;">

            <button
                class="nav-btn"
                onclick="previousSegment()"
                id="previousBtn"
            >
                ◀ Previous
            </button>

            <button
                class="save-btn"
                onclick="saveAndNext()"
                id="saveBtn"
            >
                Save & Next ▶
            </button>

        </div>

    </div>


    <!-- RESULT -->
    <div class="card hidden" id="resultCard">

        <h2>Annotation Results</h2>

        <div class="table-container">

            <table>

                <thead>
                    <tr>
                        <th>Segment</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Comment</th>
                    </tr>
                </thead>

                <tbody id="resultTable"></tbody>

            </table>

        </div>

        <button
            class="download-btn"
            onclick="downloadCSV()"
        >
            ⬇ Download CSV
        </button>

    </div>

</div>


<script>

let video;
let segmentDuration = 5;

let currentSegment = 0;

let totalSegments = 0;

let segments = [];

let projectStarted = false;


// ============================================================
// START PROJECT
// ============================================================

function startProject() {

    const videoUrl =
        document.getElementById("videoUrl").value.trim();

    segmentDuration =
        parseFloat(
            document.getElementById("segmentDuration").value
        );

    if (!videoUrl) {
        alert("Please enter a video URL.");
        return;
    }

    if (!segmentDuration || segmentDuration <= 0) {
        alert("Please enter a valid segment duration.");
        return;
    }

    video =
        document.getElementById("video");

    video.src = videoUrl;

    video.load();

    video.addEventListener(
        "loadedmetadata",
        initializeSegments,
        { once: true }
    );

    document
        .getElementById("videoCard")
        .classList.remove("hidden");

    document
        .getElementById("commentCard")
        .classList.remove("hidden");

    projectStarted = true;

    document
        .getElementById("setupCard")
        .classList.add("hidden");
}


// ============================================================
// INITIALIZE SEGMENTS
// ============================================================

function initializeSegments() {

    const duration = video.duration;

    totalSegments =
        Math.ceil(duration / segmentDuration);

    segments = [];

    for (
        let i = 0;
        i < totalSegments;
        i++
    ) {

        const start =
            i * segmentDuration;

        const end =
            Math.min(
                start + segmentDuration,
                duration
            );

        segments.push({

            segment:
                i + 1,

            start:
                start,

            end:
                end,

            comment:
                ""

        });
    }

    currentSegment = 0;

    loadSegment();

    document
        .getElementById("resultCard")
        .classList.remove("hidden");
}


// ============================================================
// LOAD CURRENT SEGMENT
// ============================================================

function loadSegment() {

    if (!segments.length) {
        return;
    }

    const segment =
        segments[currentSegment];

    video.pause();

    video.currentTime =
        segment.start;

    document
        .getElementById("segmentInfo")
        .innerText =
        "Segment " +
        segment.segment +
        " / " +
        totalSegments;

    document
        .getElementById("timeInfo")
        .innerText =
        formatTime(segment.start) +
        " – " +
        formatTime(segment.end) +
        " seconds";

    document
        .getElementById("comment")
        .value =
        segment.comment || "";

    document
        .getElementById("status")
        .innerText =
        "Ready — press Play";

    updateButtons();

    updateTable();

    updateProgress();
}


// ============================================================
// VIDEO TIME UPDATE
// ============================================================

videoTimeUpdateHandler = function() {

    if (!projectStarted) {
        return;
    }

    if (!segments.length) {
        return;
    }

    const segment =
        segments[currentSegment];

    const current =
        video.currentTime;

    const duration =
        segment.end -
        segment.start;

    const elapsed =
        current -
        segment.start;

    let percent =
        (elapsed / duration) * 100;

    percent =
        Math.max(
            0,
            Math.min(
                100,
                percent
            )
        );

    document
        .getElementById("progress")
        .style.width =
        percent + "%";


    // --------------------------------------------------------
    // AUTOMATICALLY STOP AT SEGMENT END
    // --------------------------------------------------------

    if (
        current >= segment.end
    ) {

        video.pause();

        video.currentTime =
            segment.end;

        document
            .getElementById("status")
            .innerText =
            "Segment finished — add your comment";

    }

};


// ============================================================
// ATTACH EVENT
// ============================================================

document
    .getElementById("video")
    .addEventListener(
        "timeupdate",
        videoTimeUpdateHandler
    );


// ============================================================
// SAVE CURRENT COMMENT
// ============================================================

function saveCurrentComment() {

    const comment =
        document
            .getElementById("comment")
            .value
            .trim();

    segments[currentSegment].comment =
        comment;
}


// ============================================================
// SAVE & NEXT
// ============================================================

function saveAndNext() {

    saveCurrentComment();

    if (
        currentSegment <
        totalSegments - 1
    ) {

        currentSegment++;

        loadSegment();

        video.play();

    } else {

        video.pause();

        updateTable();

        document
            .getElementById("status")
            .innerText =
            "🎉 All segments completed!";

        alert(
            "All segments have been completed. You can now download the CSV."
        );
    }
}


// ============================================================
// PREVIOUS
// ============================================================

function previousSegment() {

    saveCurrentComment();

    if (currentSegment > 0) {

        currentSegment--;

        loadSegment();

        video.play();

    }

}


// ============================================================
// UPDATE BUTTONS
// ============================================================

function updateButtons() {

    document
        .getElementById("previousBtn")
        .disabled =
        currentSegment === 0;

    if (
        currentSegment ===
        totalSegments - 1
    ) {

        document
            .getElementById("saveBtn")
            .innerText =
            "Save ✓";

    } else {

        document
            .getElementById("saveBtn")
            .innerText =
            "Save & Next ▶";

    }
}


// ============================================================
// FORMAT TIME
// ============================================================

function formatTime(seconds) {

    seconds =
        Math.floor(seconds);

    const minutes =
        Math.floor(seconds / 60);

    const secs =
        seconds % 60;

    return (
        String(minutes).padStart(2, "0") +
        ":" +
        String(secs).padStart(2, "0")
    );
}


// ============================================================
// PROGRESS
// ============================================================

function updateProgress() {

    document
        .getElementById("progress")
        .style.width =
        "0%";
}


// ============================================================
// UPDATE RESULT TABLE
// ============================================================

function updateTable() {

    const tbody =
        document
            .getElementById("resultTable");

    tbody.innerHTML = "";

    segments.forEach(
        function(segment) {

            const row =
                document.createElement("tr");

            row.innerHTML =

                "<td>" +
                segment.segment +
                "</td>" +

                "<td>" +
                formatTime(segment.start) +
                "</td>" +

                "<td>" +
                formatTime(segment.end) +
                "</td>" +

                "<td>" +
                escapeHTML(segment.comment) +
                "</td>";

            tbody.appendChild(row);

        }
    );
}


// ============================================================
// ESCAPE HTML
// ============================================================

function escapeHTML(text) {

    const div =
        document.createElement("div");

    div.textContent =
        text;

    return div.innerHTML;
}


// ============================================================
// DOWNLOAD CSV
// ============================================================

function downloadCSV() {

    saveCurrentComment();

    let csv =
        "Segment,Start_Seconds,End_Seconds,Start_Time,End_Time,Comment\n";

    segments.forEach(
        function(segment) {

            csv +=

                segment.segment +
                "," +

                segment.start +
                "," +

                segment.end +
                "," +

                formatTime(segment.start) +
                "," +

                formatTime(segment.end) +
                "," +

                csvEscape(segment.comment) +

                "\n";

        }
    );

    const blob =
        new Blob(
            [csv],
            {
                type:
                "text/csv;charset=utf-8;"
            }
        );

    const url =
        URL.createObjectURL(blob);

    const link =
        document.createElement("a");

    link.href = url;

    link.download =
        "video_annotations.csv";

    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);

    URL.revokeObjectURL(url);
}


// ============================================================
// CSV ESCAPE
// ============================================================

function csvEscape(value) {

    value =
        String(value || "");

    value =
        value.replace(
            /"/g,
            '""'
        );

    return '"' +
        value +
        '"';
}

</script>

</body>
</html>
